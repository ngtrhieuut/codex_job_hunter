# Local mode uses a durable JSON store under .data/ when DATABASE_URL is absent.
DATABASE_URL=postgres://user:password@localhost:5432/codex_job_hunter

# Optional GitHub token for higher-rate public issue discovery and checkpoint writes.
# Never commit a real token. Public discovery works anonymously with lower rate limits.
GITHUB_TOKEN=
GITHUB_REPOSITORY=ngtrhieuut/codex_job_hunter
GITHUB_BRANCH=main

# Optional owner authentication. Leave empty for a private local-only development server.
APP_OWNER_TOKEN=

# Optional local JSON store override.
DATA_STORE_PATH=.data/store.json
