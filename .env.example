# Explicit runtime store selection. Use json only for development/tests; use postgres in deployment.
APP_STORE=json
# Set only for a deliberately non-durable emergency local mode; never use for production jobs.
ALLOW_LOCAL_JSON_PRODUCTION=false

DATABASE_URL=postgres://user:password@localhost:5432/codex_job_hunter

# Optional GitHub token for higher-rate public issue discovery and checkpoint writes.
# Never commit a real token. Public discovery works anonymously with lower rate limits.
GITHUB_TOKEN=
GITHUB_REPOSITORY=ngtrhieuut/codex_job_hunter
GITHUB_BRANCH=main
GITHUB_JOBS_ROOT=jobs
GITHUB_CONTROL_BOARD_PATH=CONTROL_BOARD.md

# Optional owner authentication. Leave empty for a private local-only development server.
APP_OWNER_TOKEN=

# Optional local JSON store override.
DATA_STORE_PATH=.data/store.json

# Optional local workspace/control-board overrides for tests or isolated development.
JOBS_ROOT=jobs
CONTROL_BOARD_PATH=CONTROL_BOARD.md
